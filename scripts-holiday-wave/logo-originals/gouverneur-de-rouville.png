.gv .gv-hero h1,.gv .gv-view h2,.gv .gv-info h3{color:#fff !important;}
.gv .gv-welcome h2,.gv .gv-menus h2,.gv .gv-tile h3,.gv .gv-group h3,.gv .gv-cta h2{color:#1f1a17 !important;}
.gv .gv-eyebrow{color:#b08d57 !important;}
.gv .gv-hero .gv-eyebrow,.gv .gv-view .gv-eyebrow,.gv .gv-hero h1 em{color:#e2c48f !important;}
.gv .gv-welcome h2 em{color:#8c1c26 !important;}

/* 'Powered by Odoo' in de footer verbergen */
.o_brand_promotion{display:none !important;}
