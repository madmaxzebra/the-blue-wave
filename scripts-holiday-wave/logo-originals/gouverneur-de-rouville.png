@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap');

.gv *{box-sizing:border-box;margin:0;padding:0;}
.gv{
  --cream:#f7f1e6; --cream2:#efe5d3; --ink:#1f1a17; --muted:#5e544b;
  --bordeaux:#8c1c26; --bordeaux2:#a8262f; --gold:#b08d57; --line:#d9c9a8;
  font-family:'Lato',-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  background:var(--cream);color:var(--ink);line-height:1.65;width:100%;overflow:hidden;
}
.gv img{display:block;width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none;}
.gv h1,.gv h2,.gv h3{font-family:'Playfair Display',Georgia,serif;font-weight:400;line-height:1.15;}
.gv-wrap{max-width:1140px;margin:0 auto;padding:0 2rem;}
.gv-eyebrow{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;}
.gv-orn{display:flex;align-items:center;justify-content:center;gap:14px;margin:0 auto 18px;color:var(--gold);}
.gv-orn:before,.gv-orn:after{content:"";height:1px;width:70px;background:var(--gold);}
.gv-orn span{font-size:14px;}

/* knoppen */
.gv-btn{display:inline-block;font-size:13px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:14px 28px;border-radius:2px;transition:.25s;cursor:pointer;}
.gv-btn-red{background:var(--bordeaux);color:#fff;border:1px solid var(--bordeaux);}
.gv-btn-red:hover{background:var(--bordeaux2);border-color:var(--bordeaux2);}
.gv-btn-line{border:1px solid rgba(255,255,255,.7);color:#fff;}
.gv-btn-line:hover{background:#fff;color:var(--ink);}
.gv-btn-dark{border:1px solid var(--ink);color:var(--ink);}
.gv-btn-dark:hover{background:var(--ink);color:var(--cream);}

/* HERO */
.gv-hero{position:relative;min-height:88vh;display:flex;align-items:center;justify-content:center;text-align:center;background:#120d0b;}
.gv-hero>img{position:absolute;inset:0;object-position:center 35%;}
.gv-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,10,8,.45) 0%,rgba(15,10,8,.35) 45%,rgba(15,10,8,.75) 100%);}
.gv-hero-body{position:relative;z-index:2;padding:4rem 1.5rem;max-width:820px;}
.gv-hero .gv-eyebrow{color:#e2c48f;}
.gv-hero h1{font-size:clamp(40px,7vw,78px);color:#fff;margin-bottom:10px;}
.gv-hero h1 em{font-style:italic;color:#e2c48f;}
.gv-hero p{font-size:clamp(16px,2vw,19px);color:#efe6d6;font-weight:300;margin-bottom:30px;}
.gv-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
.gv-hero-info{position:absolute;z-index:2;bottom:22px;left:0;right:0;text-align:center;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#d8cbb4;}

/* WELKOM */
.gv-welcome{padding:6rem 0 5rem;}
.gv-welcome-grid{display:grid;grid-template-columns:1fr 1fr;gap:4.5rem;align-items:center;}
.gv-welcome h2{font-size:clamp(30px,4vw,44px);margin-bottom:20px;}
.gv-welcome h2 em{color:var(--bordeaux);font-style:italic;}
.gv-welcome p{color:var(--muted);font-size:16px;margin-bottom:16px;}
.gv-welcome-img{position:relative;height:500px;}
.gv-welcome-img:before{content:"";position:absolute;inset:-14px 14px 14px -14px;border:1px solid var(--gold);z-index:0;}
.gv-welcome-img img{position:relative;z-index:1;}
.gv-sign{font-family:'Playfair Display',serif;font-style:italic;font-size:20px;color:var(--bordeaux);margin-top:8px;}

/* MENU TEGELS */
.gv-menus{padding:5rem 0;background:var(--cream2);text-align:center;}
.gv-menus h2{font-size:clamp(30px,4vw,42px);margin-bottom:10px;}
.gv-lead{color:var(--muted);max-width:560px;margin:0 auto 44px;}
.gv-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;text-align:left;}
.gv-tile{display:block;background:#fff;transition:.3s;border:1px solid var(--line);}
.gv-tile:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(60,40,20,.12);}
.gv-tile-img{height:260px;overflow:hidden;}
.gv-tile-img img{transition:transform .6s;}
.gv-tile:hover .gv-tile-img img{transform:scale(1.05);}
.gv-tile-body{padding:24px 26px 28px;}
.gv-tile-time{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:6px;}
.gv-tile h3{font-size:24px;margin-bottom:8px;color:var(--ink);}
.gv-tile p{font-size:14.5px;color:var(--muted);margin-bottom:14px;}
.gv-tile-link{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--bordeaux);}

/* UITZICHT / QUOTE */
.gv-view{position:relative;min-height:460px;display:flex;align-items:center;background:#120d0b;}
.gv-view>img{position:absolute;inset:0;}
.gv-view:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,10,8,.82) 0%,rgba(15,10,8,.55) 50%,rgba(15,10,8,.1) 100%);}
.gv-view-body{position:relative;z-index:2;max-width:520px;}
.gv-view .gv-eyebrow{color:#e2c48f;}
.gv-view h2{font-size:clamp(28px,4vw,42px);color:#fff;margin-bottom:16px;}
.gv-view p{color:#e6dccb;margin-bottom:26px;font-weight:300;font-size:16px;}

/* GROEPEN */
.gv-groups{padding:5.5rem 0;}
.gv-groups-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;}
.gv-group{border:1px solid var(--line);padding:42px 38px;background:#fff;position:relative;}
.gv-group:before{content:"";position:absolute;top:0;left:38px;width:46px;height:3px;background:var(--bordeaux);}
.gv-group h3{font-size:28px;margin-bottom:10px;}
.gv-group p{color:var(--muted);margin-bottom:22px;font-size:15px;}
.gv-group ul{list-style:none;margin-bottom:26px;}
.gv-group li{font-size:14.5px;padding:7px 0;border-bottom:1px solid #eee4d2;color:var(--ink);}
.gv-group li:before{content:"◆";color:var(--gold);font-size:9px;margin-right:12px;vertical-align:2px;}

/* INFO */
.gv-info{background:var(--ink);color:#d9cdb9;padding:5rem 0;}
.gv-info-grid{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:3rem;}
.gv-info h3{font-size:22px;color:#fff;margin-bottom:16px;}
.gv-info p,.gv-info li{font-size:15px;color:#cfc2ac;}
.gv-hours{list-style:none;}
.gv-hours li{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid #3a322b;}
.gv-hours span:last-child{color:#fff;}
.gv-info .gv-small{font-size:13px;color:#a69a86;margin-top:12px;}
.gv-map{height:250px;border:1px solid #3a322b;filter:grayscale(.35) contrast(1.05);}
.gv-map iframe{width:100%;height:100%;border:0;display:block;}
.gv-social{display:flex;gap:16px;margin-top:18px;flex-wrap:wrap;}
.gv-social a{font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#e2c48f;border-bottom:1px solid #6a5636;padding-bottom:2px;}

/* SLOT CTA */
.gv-cta{padding:5rem 0;text-align:center;background:var(--cream);}
.gv-cta h2{font-size:clamp(28px,4vw,40px);margin-bottom:10px;}
.gv-cta p{color:var(--muted);margin-bottom:28px;}

/* RESPONSIVE */
@media(max-width:900px){
  .gv-welcome-grid{grid-template-columns:1fr;gap:3rem;}
  .gv-welcome-img{height:380px;margin:0 14px;}
  .gv-tiles{grid-template-columns:1fr;max-width:520px;margin:0 auto;}
  .gv-groups-grid{grid-template-columns:1fr;}
  .gv-info-grid{grid-template-columns:1fr 1fr;}
  .gv-info-grid>div:last-child{grid-column:1/-1;}
}
@media(max-width:640px){
  .gv-wrap{padding:0 1.25rem;}
  .gv-hero{min-height:82vh;}
  .gv-hero-info{display:none;}
  .gv-welcome{padding:4rem 0 3.5rem;}
  .gv-menus,.gv-groups,.gv-info,.gv-cta{padding:3.5rem 0;}
  .gv-tile-img{height:210px;}
  .gv-view{min-height:420px;}
  .gv-view:after{background:rgba(15,10,8,.62);}
  .gv-group{padding:34px 24px;}
  .gv-group:before{left:24px;}
  .gv-info-grid{grid-template-columns:1fr;gap:2.5rem;}
}

/* Odoo-thema overschrijven */
.gv a,.gv a:hover,.gv a:focus{text-decoration:none !important;}
.gv a.gv-btn-red{color:#fff !important;}
